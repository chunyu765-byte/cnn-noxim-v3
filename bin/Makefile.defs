#############################
# Noxim - the NoC Simulator #
#############################

# NOTE FOR NOXIM USERS: before running "make" you just have to modify
# the following variable to point to your SystemC installation path
#
#SYSTEMC = /usr/systemc
#SYSTEMC = /SYSTEMC/systemc
SYSTEMC ?= $(if $(wildcard $(HOME)/.local/systemc-3.0.2),$(HOME)/.local/systemc-3.0.2,/usr/local/systemc-2.3.1)
SYSTEMC_PKGCONFIG := $(shell pkg-config --exists systemc 2>/dev/null && echo yes)
#
# That's all for you!!!

ifeq ($(SYSTEMC_PKGCONFIG),yes)
SYSTEMC_CFLAGS := $(shell pkg-config --cflags systemc)
SYSTEMC_LIBS := $(shell pkg-config --libs systemc)
SYSTEMC_PREREQ :=
else
SYSTEMC_CFLAGS := -I$(SYSTEMC)/include
SYSTEMC_LIBS := -L$(SYSTEMC)/lib-$(TARGET_ARCH) -lsystemc
SYSTEMC_PREREQ := $(SYSTEMC)/lib-$(TARGET_ARCH)/libsystemc.a
endif

INCDIR = -I. -I.. -I../src $(SYSTEMC_CFLAGS)
LIBDIR = -L. -L.. -L../src
#-Wl,-rpath,$(SYSTEMC)/lib-$(TARGET_ARCH)

#EXTRA_LIBS = -lpthread
LIBS = $(SYSTEMC_LIBS) -lm $(EXTRA_LIBS)



EXE    = $(BUILDDIR)/$(MODULE)

.SUFFIXES: .cpp .c .o 

$(EXE): $(OBJS) $(OBJS_C) $(SYSTEMC_PREREQ)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(INCDIR) $(LIBDIR) -o $@ $(OBJS_A) $(LIBS) 2>&1 | c++filt

$(BUILDDIR)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(INCDIR) -c $< -o $@

$(BUILDDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	gcc -c $(INCDIR) $< -o $@
clean:
#	rm -f $(OBJS) *~ *.o $(EXE) core
	rm -rf $(BUILDDIR)
	rm -f *~ *.o *.flp PE_R_* PE_T_* output**.lcf grid_steady_temp core

depend: 
	makedepend $(SRCS) -Y -f Makefile.deps

include ./Makefile.deps
